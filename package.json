{
  "name": "local-finance-mcp",
  "version": "0.1.0",
  "description": "Local-first personal finance ledger with a pluggable provider model, exposed to AI agents over MCP.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "finance": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./providers": "./dist/providers/types.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs",
    "!docs/images"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "prepare": "npm run build",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "finance": "node dist/cli.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^11.0.0",
    "commander": "^12.0.0",
    "csv-parse": "^7.0.3",
    "nodemailer": "^10.3.1",
    "smol-toml": "^1.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "author": "Brandon Taylor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brandonmtaylor/local-finance-mcp.git"
  },
  "homepage": "https://github.com/brandonmtaylor/local-finance-mcp#readme",
  "bugs": {
    "url": "https://github.com/brandonmtaylor/local-finance-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "finance",
    "personal-finance",
    "budgeting",
    "ledger",
    "plaid",
    "sqlite",
    "local-first",
    "privacy",
    "cli"
  ]
}
